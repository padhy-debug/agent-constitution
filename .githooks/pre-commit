#!/usr/bin/env bash
# Agent Constitution - Pre-Commit Runtime Guardrail
# Deterministically rejects commits that violate constitutional axioms:
# 1. Mandatory CONTEXT.md and TASKS.md presence
# 2. Rejects raw template placeholders (<short title>, <task description>)
# 3. Detects accidental secret/credential leakage

set -euo pipefail

echo "🔍 [Constitutional Guardrail] Validating pre-commit invariants..."

# 1. Check for core memory files
if [ ! -f "CONTEXT.md" ]; then
    echo "❌ [REJECTED] CONTEXT.md is missing. Agents must maintain persistent project memory."
    exit 1
fi

if [ ! -f "TASKS.md" ]; then
    echo "❌ [REJECTED] TASKS.md is missing. Agents must record active task state."
    exit 1
fi

# 2. Check for raw unpopulated template strings in staged files
STAGED_FILES=$(git diff --cached --name-only || true)

if echo "$STAGED_FILES" | grep -q "^CONTEXT.md$"; then
    if grep -q "<short title>" CONTEXT.md; then
        echo "❌ [REJECTED] CONTEXT.md contains raw template placeholder '<short title>'."
        exit 1
    fi
fi

if echo "$STAGED_FILES" | grep -q "^TASKS.md$"; then
    if grep -q "<task description>" TASKS.md; then
        echo "❌ [REJECTED] TASKS.md contains raw template placeholder '<task description>'."
        exit 1
    fi
fi

# 3. Scan staged files for accidental hardcoded secret patterns
SUSPICIOUS_PATTERNS='(AKIA[0-9A-Z]{16}|ghp_[0-9a-zA-Z]{36}|-----BEGIN (RSA|EC|OPENSSH) PRIVATE KEY-----)'
if git diff --cached | grep -E -q "$SUSPICIOUS_PATTERNS" 2>/dev/null; then
    echo "❌ [REJECTED] Potential raw secret/private key detected in staged diff!"
    exit 1
fi

echo "✅ [Constitutional Guardrail] Pre-commit validation passed."
exit 0
